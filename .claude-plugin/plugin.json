{
  "name": "hitechcloudomnichannel",
  "version": "1.1.1",
  "description": "HiTechCloudOmnichannel for AI agents: the hitechcloudomnichannel CLI skill, the hitechcloudomnichannel MCP server, and the MCP usage skill for contacts, conversations, flows, broadcasts, sequences, and analytics.",
  "author": {
    "name": "hitechcloud-vietnam",
    "email": "support@hitechcloud.vn",
    "url": "https://hitechcloud.vn"
  },
  "homepage": "https://hitechcloud.vn",
  "repository": "https://github.com/hitechcloud-vietnam/HiTechCloudOmnichannel-agent",
  "license": "MIT-0",
  "keywords": ["hitechcloudomnichannel", "mcp", "cli", "automation", "ai-agent"],
  "skills": ["./skills/hitechcloudomnichannel", "./skills/hitechcloudomnichannel-mcp"],
  "mcpServers": {
    "hitechcloudomnichannel": {
      "command": "npx",
      "args": ["-y", "hitechcloudomnichannel-mcp"],
      "env": {
        "HITECHCLOUDOMNICHANNEL_API_KEY": "${user_config.api_key}",
        "HITECHCLOUDOMNICHANNEL_API_URL": "https://app.hitechcloud.vn/api",
        "HITECHCLOUDOMNICHANNEL_MCP_TRANSPORT": "stdio"
      }
    }
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "HiTechCloudOmnichannel API key",
      "description": "Workspace API key from HiTechCloudOmnichannel Settings → Developer → API Keys.",
      "sensitive": true,
      "required": true
    }
  }
}
