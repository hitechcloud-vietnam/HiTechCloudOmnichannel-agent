{
  "name": "hitechcloudomnichannel",
  "version": "1.1.1",
  "description": "HiTechCloudOmnichannel agentic workspace automation. Manage contacts, conversations, flows, broadcasts, sequences, analytics, and omnichannel messaging through CLI and MCP tools.",
  "author": {
    "name": "hitechcloud-vietnam",
    "email": "support@hitechcloud.vn",
    "url": "https://hitechcloud.vn"
  },
  "homepage": "https://hitechcloud.vn",
  "repository": "https://github.com/hitechcloud-vietnam/HiTechCloudOmnichannel-agent",
  "license": "MIT-0",
  "logo": "assets/logo.svg",
  "keywords": ["hitechcloudomnichannel", "hitechcloudomnichannel cli", "hitechcloudomnichannel mcp", "omnichannel automation", "ai-agent"],
  "skills": ["./skills/hitechcloudomnichannel", "./skills/hitechcloudomnichannel-mcp"],
  "mcpServers": {
    "hitechcloudomnichannel": {
      "command": "npx",
      "args": ["-y", "hitechcloudomnichannel-mcp"],
      "env": {
        "HITECHCLOUDOMNICHANNEL_API_KEY": "${HITECHCLOUDOMNICHANNEL_API_KEY}",
        "HITECHCLOUDOMNICHANNEL_API_URL": "https://app.hitechcloud.vn/api",
        "HITECHCLOUDOMNICHANNEL_MCP_TRANSPORT": "stdio"
      },
      "note": "Starts the official HiTechCloudOmnichannel MCP server over stdio. Requires HITECHCLOUDOMNICHANNEL_API_KEY; edit the URL for a self-hosted instance."
    }
  }
}
