{
  "name": "chatbotx",
  "version": "1.1.1",
  "description": "ChatbotX agentic workspace automation. Manage contacts, conversations, flows, broadcasts, sequences, analytics, and omnichannel messaging through CLI and MCP tools.",
  "author": {
    "name": "hitechcloud-vietnam",
    "email": "support@hitechcloud.vn",
    "url": "https://hitechcloud.vn"
  },
  "homepage": "https://hitechcloud.vn",
  "repository": "https://github.com/hitechcloud-vietnam/HiTechCloudOmnichannel-agent",
  "license": "MIT-0",
  "logo": "assets/logo.svg",
  "keywords": ["chatbotx", "chatbotx cli", "chatbotx mcp", "omnichannel automation", "ai-agent"],
  "skills": ["./skills/chatbotx", "./skills/chatbotx-mcp"],
  "mcpServers": {
    "chatbotx": {
      "command": "npx",
      "args": ["-y", "chatbotx-mcp"],
      "env": {
        "CHATBOTX_API_KEY": "${CHATBOTX_API_KEY}",
        "CHATBOTX_API_URL": "https://app.hitechcloud.vn/api",
        "CHATBOTX_MCP_TRANSPORT": "stdio"
      },
      "note": "Starts the official ChatbotX MCP server over stdio. Requires CHATBOTX_API_KEY; edit the URL for a self-hosted instance."
    }
  }
}
